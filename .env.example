# Copy to .env for local overrides. Never commit .env.
CASSANDRA_HOSTS=cassandra
CASSANDRA_KEYSPACE=bank
CASSANDRA_AUTH=none            # none | sigv4
CASSANDRA_TLS=false
CASSANDRA_CONSISTENCY=LOCAL_QUORUM
KAFKA_BROKERS=kafka:9092
KAFKA_SASL=none                # none | aws-msk-iam
AWS_REGION=ap-southeast-2
ENVOY_GRPC_ADDR=envoy:8081
OTEL_EXPORTER_OTLP_ENDPOINT=   # e.g. jaeger:4317 (empty disables tracing)
SINK_DIR=/data/sink            # local folder sink
SINK_S3_BUCKET=                # set in AWS to write to S3
